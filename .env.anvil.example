# Local demo environment: anvil + local Supabase + mock AI + wallet sign-in.
# Copy to `.env` at the repo root (cp .env.anvil.example .env). Every value here is a public local default:
# anvil's well-known dev keys and the Supabase CLI's local demo keys. Never use them on a real network.

# Chain: anvil started with `anvil --block-time 1`
BASE_SEPOLIA_RPC_URL=http://127.0.0.1:8545
CHAIN_ID=31337
# Ignored on anvil (the deploy script deploys MockUSDC), kept so the web env validates
USDC_ADDRESS=0x5FbDB2315678afecb367f032d93F642f64180aa3
# anvil account 4
TREASURY_ADDRESS=0x15d34AAf54267DB7D7c367839AAf71A00a2C6A65

# anvil accounts 0 to 3
DEPLOYER_PRIVATE_KEY=0xac0974bec39a17e36ba4a6b4d238ff944bacb478cbed5efcae784d7bf4f2ff80
OPERATOR_PRIVATE_KEY=0x59c6995e998f97a5a0044966f0945389dc9e86dae88c7a8412f4603b6b78690d
ATTESTER_PRIVATE_KEY=0x5de4111afa1a4b94908f83103eb1f1706367c2e68ca870fc3fb9a804cdab365a
RELAYER_PRIVATE_KEY=0x7c852118294e51e653712a81e05800f419141751be58f605c371e15141b007a6

# Local Supabase (`pnpm db:start`, ports from supabase/config.toml)
SUPABASE_URL=http://127.0.0.1:44321
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZS1kZW1vIiwicm9sZSI6ImFub24iLCJleHAiOjE5ODM4MTI5OTZ9.CRXP1A7WOeoJeXxjNni43kdQwgnWNReilDMblYTn_I0
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZS1kZW1vIiwicm9sZSI6InNlcnZpY2Vfcm9sZSIsImV4cCI6MTk4MzgxMjk5Nn0.EGIM96RAZx35lJzdJsyH-qQwv8Hdp7fsn3W0YpN81IU

PUBLIC_APP_URL=http://localhost:3000

# Sign-in: the demo scripts use wallet-signature tokens. Add Privy keys to test real sign-in as well.
DEMO_WALLET_AUTH=true
PRIVY_APP_ID=
PRIVY_APP_SECRET=

# Deterministic mock scorer (see docs/evidence-pipeline.md)
MOCK_AI=true
AI_SERVICE_URL=
AI_SERVICE_TOKEN=

# One campaign time unit in seconds. 60 keeps the full 36-unit lifecycle near 40 minutes in real time.
DEMO_TIME_UNIT_SECONDS=60

LOG_LEVEL=info
