# Treecord environment variables
# Copy to `.env` at the repo root and fill in. Never commit `.env`.
# apps/web and apps/worker both load this root file in local development.
# On Vercel and Railway, set the same names in the platform's env settings.

# ---------------------------------------------------------------------------
# Chain (contracts, web, worker)
# ---------------------------------------------------------------------------
# HTTPS RPC endpoint for Base Sepolia (Alchemy, Infura, QuickNode, or https://sepolia.base.org for light use)
BASE_SEPOLIA_RPC_URL=https://sepolia.base.org
# Base Sepolia chain id. Do not change.
CHAIN_ID=84532
# Circle test USDC on Base Sepolia (6 decimals). Verify on https://developers.circle.com/stablecoins/usdc-contract-addresses
USDC_ADDRESS=0x036CbD53842c5426634e7929541eC2318f3dCF7e
# Treasury wallet that receives seedling, verification, and fee buckets, and holds carbon inventory
TREASURY_ADDRESS=

# ---------------------------------------------------------------------------
# Keys (0x-prefixed 32-byte hex). Use separate test-only wallets for each.
# ---------------------------------------------------------------------------
# contracts: deploys contracts and holds DEFAULT_ADMIN_ROLE
DEPLOYER_PRIVATE_KEY=
# worker: OPERATOR_ROLE and ISSUER_ROLE calls (claims, anchor assignment, flags, estimates, issuance)
OPERATOR_PRIVATE_KEY=
# web + worker: signs EIP-712 attestations (ATTESTER_ROLE). Never sends transactions.
ATTESTER_PRIVATE_KEY=
# worker: submits signed attestations to VerificationGateway and pays gas
RELAYER_PRIVATE_KEY=

# ---------------------------------------------------------------------------
# Supabase (web, worker)
# ---------------------------------------------------------------------------
# Local `supabase start` prints these. Cloud values are under Project Settings > API.
SUPABASE_URL=http://127.0.0.1:44321
# Public anon key. Reserved for direct client access in the PWA later.
SUPABASE_ANON_KEY=
# Service role key. Server only. Bypasses RLS.
SUPABASE_SERVICE_ROLE_KEY=

# ---------------------------------------------------------------------------
# Web app (web)
# ---------------------------------------------------------------------------
# Public base URL of the web app. Campaign metadata URIs point here.
PUBLIC_APP_URL=http://localhost:3000

# ---------------------------------------------------------------------------
# Privy auth (web)
# ---------------------------------------------------------------------------
# From the Privy dashboard. The app id is public, the secret is server only.
# Required unless DEMO_WALLET_AUTH is true.
PRIVY_APP_ID=
PRIVY_APP_SECRET=
# Also accept wallet-signature tokens, which the demo scripts use to sign in as the demo users.
# Anyone can sign in this way with a wallet they hold, so turn it on only for demo deployments.
DEMO_WALLET_AUTH=false

# ---------------------------------------------------------------------------
# AI scoring service (worker). See AI_SERVICE_INTERFACE.md.
# ---------------------------------------------------------------------------
# Set MOCK_AI=true to use the deterministic mock scorer. URL and token are then optional.
MOCK_AI=true
AI_SERVICE_URL=
AI_SERVICE_TOKEN=

# ---------------------------------------------------------------------------
# Demo (contracts scripts, scripts/demo). See README.md and docs/deploy.md.
# ---------------------------------------------------------------------------
# Length of one campaign time unit in seconds for demo campaigns. Production uses 2592000 (30 days).
DEMO_TIME_UNIT_SECONDS=180
# API the demo scripts call. Defaults to PUBLIC_APP_URL.
DEMO_API_URL=
# Funding target of the demo campaign in USDC base units (5 USDC fits one Circle faucet request).
DEMO_FUNDING_TARGET=5000000
# Wallet that sends test ETH and USDC to the demo donors. Defaults to DEPLOYER_PRIVATE_KEY.
DEMO_FUNDER_PRIVATE_KEY=
# BIP-39 phrase for the seven demo wallets. If empty on Base Sepolia, the seed generates one and keeps it in
# scripts/demo/.state/84532.json.
DEMO_MNEMONIC=

# ---------------------------------------------------------------------------
# Worker runtime (worker)
# ---------------------------------------------------------------------------
# pino log level: fatal, error, warn, info, debug, trace
LOG_LEVEL=info
